        "workflowJson": "{\n  \"nodes\": [\n    {\n      \"parameters\": {},\n      \"id\": \"e45a12cd-8b9a-4c22-b5df-1e8c2a9d8e7b\",\n      \"name\": \"Execute Workflow Trigger\",\n      \"type\": \"n8n-nodes-base.executeWorkflowTrigger\",\n      \"typeVersion\": 1,\n      \"position\": [\n        460,\n        460\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"try {\\n  // Try to connect with a strict 3-second timeout\\n  await this.helpers.httpRequest({\\n    method: 'GET',\\n    url: 'http://192.168.1.5:8080',\\n    timeout: 3000\\n  });\\n  \\n  // If it connects successfully, return this clean JSON\\n  return [{ json: { status: \\\"The website is up and running successfully.\\\" } }];\\n\\n} catch (error) {\\n  // If the server is down, it instantly catches the error and returns this clean JSON\\n  return [{ json: { status: \\\"The website is down. The server is offline or the connection was refused.\\\" } }];\\n}\"\n      },\n      \"id\": \"f8a9b2c1-d3e4-4f56-a7b8-9c0d1e2f3a4b\",\n      \"name\": \"Check website status via subflow\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        680,\n        460\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Execute Workflow Trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Check website status via subflow\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  }\n}"
