    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  try {\n    // 1. Parse the AI's string response into a real JSON object\n    const aiData = JSON.parse(item.json.output);\n    \n    // 2. Extract the specific fields and attach them directly to the n8n item\n    results.push({\n      json: {\n        category: aiData.category,\n        summary: aiData.summary,\n        key_points: aiData.key_points,\n        importance_score: aiData.importance_score,\n        \n        // It is highly recommended to keep the original title and link \n        // so you don't lose them for the next steps!\n        title: item.json.title,\n        link: item.json.link\n      }\n    });\n\n  } catch (error) {\n    // 3. Fallback: If the AI hallucinates bad JSON, catch the error \n    // so the node doesn't crash for the rest of the good articles.\n    results.push({\n      json: {\n        error: \"Failed to parse AI output\",\n        details: error.message,\n        raw_output: item.json.output\n      }\n    });\n  }\n}\n\n// 4. Return the new list of neatly separated items\nreturn results;"
      },
